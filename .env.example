# ─── SyncMe — Environment Configuration ─────────────────────────────────────
# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored — never commit real keys.

# ── Google OAuth 2.0 (read-only Gmail access) ──
# Google Cloud Console (Testing mode, $0 cost):
# 1. console.cloud.google.com → create/select a project
# 2. APIs & Services → Library → enable "Gmail API"
# 3. APIs & Services → OAuth consent screen → External → add your Gmail as Test user
# 4. APIs & Services → Credentials → Create Credentials → OAuth client ID
#    → Application type: Web application
#    → Authorized redirect URI: http://localhost:3000/api/auth/callback
#      (add https://<your-deployment>/api/auth/callback for production too)
# 5. Copy the Client ID and Client Secret here:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Z.ai GLM extraction engine (glm-4.7-flash) ──
# Create a key at https://z.ai (API Keys) and paste it here.
ZAI_API_KEY=

# ── Public app URL ──
# Must match the origin of the Authorized redirect URI above.
# If left unset, SyncMe detects the request origin dynamically, so both
# http://localhost:3000 and https://syncme.vercel.app work seamlessly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: override the GLM model name ──
# ZAI_MODEL=glm-4.7-flash
